---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
interface Props { title: string; description: string; eyebrow: string; heading: string; noindex?: boolean; }
const {title,description,eyebrow,heading,noindex = false} = Astro.props;
---
<BaseLayout title={`${title} — Arveen Poonia`} description={description} noindex={noindex}>
  <SiteHeader breadcrumb={title} />
  <main id="main-content" class="inner-page" tabindex="-1">
    <div class="page-intro content-wrap"><p class="eyebrow">{eyebrow}</p><h1>{heading}</h1><p class="page-lead">{description}</p><slot name="intro" /></div>
    <slot />
  </main>
  <SiteFooter />
</BaseLayout>
