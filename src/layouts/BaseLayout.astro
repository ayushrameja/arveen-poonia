---
import '../styles/global.css';
import '../styles/route-transitions.css';
import '../styles/closing-tone.css';
import ToneBackdrop from '../components/ToneBackdrop.astro';
import { ClientRouter } from 'astro:transitions';

const routeTransition = {
  forwards: {
    old: { name: 'route-exit', duration: '180ms', easing: 'ease-in', fillMode: 'both' },
    new: { name: 'route-enter', duration: '420ms', delay: '100ms', easing: 'cubic-bezier(.22,1,.36,1)', fillMode: 'both' },
  },
  backwards: {
    old: { name: 'route-exit-back', duration: '180ms', easing: 'ease-in', fillMode: 'both' },
    new: { name: 'route-enter-back', duration: '420ms', delay: '100ms', easing: 'cubic-bezier(.22,1,.36,1)', fillMode: 'both' },
  },
};

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}

const {
  title = 'Arveen Poonia',
  description = 'Explore bhakti, yoga, and conscious living with Arveen Poonia.',
  image,
  imageAlt = '',
  noindex = false,
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const socialImage = image && Astro.site ? new URL(image, Astro.site) : undefined;
const preventIndexing = noindex || !Astro.site;
---
<!doctype html>
<html lang="en" transition:name="root" transition:animate={routeTransition}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ClientRouter />
    <meta name="theme-color" content="#faf9f5" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="preload" href="/fonts/google-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={preventIndexing ? 'noindex, nofollow' : 'index, follow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Arveen Poonia" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {socialImage && <meta name="twitter:image:alt" content={imageAlt} />}
  </head>
  <body data-page={Astro.url.pathname === "/" ? "home" : "interior"}>
    <ToneBackdrop page />
    <slot />
  </body>
</html>

<script>
  import { initClosingTone } from '../scripts/closing-tone';
  import { initPageMotion } from '../scripts/page-motion';
  import { onPageReady } from '../scripts/page-ready';
  const stop = onPageReady(() => { initPageMotion(); initClosingTone(); });
  if (import.meta.hot) import.meta.hot.dispose(stop);
</script>
