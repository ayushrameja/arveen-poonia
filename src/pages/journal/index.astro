---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import HeroCta from '../../components/HeroCta.astro';
import { articles } from '../../data/journal';
import '../../styles/journal.css';
---
<BaseLayout title="Journal — Arveen Poonia" description="Short guides for finding your way, making space for practice, and bringing a little intention to the everyday.">
  <SiteHeader breadcrumb="Journal" />
  <main id="main-content" class="journal-page" tabindex="-1">
    <section class="journal-intro content-wrap" aria-labelledby="journal-heading">
      <div><p class="journal-kicker"><span aria-hidden="true">✳</span> A LITTLE ROOM TO REFLECT</p><h1 id="journal-heading">Slow down.<br /><span>Stay curious.</span></h1></div>
      <div class="journal-intro-note"><p>Short guides for finding your way, making space for practice, and bringing a little intention to the everyday.</p><a class="journal-index-link" href="#journal-entries"><span class="link-label">Find a moment to read</span><span aria-hidden="true">↓</span></a></div>
    </section>

    <section class="journal-shelf" id="journal-entries" aria-labelledby="entries-heading"><div class="content-wrap">
      <div class="journal-shelf-heading"><h2 id="entries-heading">A few words to take with you.</h2><p>{String(articles.length).padStart(2, '0')} short reads</p></div>
      <div class="journal-entries">{articles.map((article,index) => (
        <a class="journal-row" href={`/journal/${article.slug}/`}>
          <div class="journal-entry-top"><span>0{index+1} / THE JOURNAL</span><span>{article.frontmatter.readTime}</span></div>
          <div class:list={['journal-entry-art', {'journal-entry-art--practice': article.slug === 'before-your-first-class'}]} aria-hidden="true"><i></i><i></i><i></i><span>✳</span></div>
          <p class="journal-entry-category">{article.frontmatter.category}</p><h3>{article.frontmatter.title}</h3><p class="journal-entry-description">{article.frontmatter.description}</p>
          <span class="journal-entry-action"><span>Read the guide</span><span aria-hidden="true">↗</span></span>
        </a>
      ))}</div>
      <p class="journal-shelf-note"><span aria-hidden="true">✧</span> A little reading. A little room to reflect.</p>
    </div></section>

    <section class="journal-closing content-wrap" aria-labelledby="closing-heading">
      <div class="journal-closing-copy"><p class="journal-kicker">WORDS INTO PRACTICE</p><h2 id="closing-heading">A thought to keep.<br /><span>A step to take.</span></h2><p>Sometimes the next step is simply making time for one.</p><HeroCta href="/explore/" label="Find something to watch" /></div>
      <div class="journal-pause-art"><span>AT YOUR OWN PACE</span><p>Read a little.<br />Reflect a little.<br /><span>Let it stay with you.</span></p><small>There’s room to take your time.</small><div class="journal-pause-orbits" aria-hidden="true"></div></div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
