---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { articles } from '../../data/journal';
export function getStaticPaths(){ return articles.map(article=>({params:{slug:article.slug},props:{article}})); }
const {article}=Astro.props;
const {Content,frontmatter}=article;
---
<BaseLayout title={`${frontmatter.title} — Arveen Poonia`} description={frontmatter.description}>
<SiteHeader /><main id="main-content" tabindex="-1" class="inner-page"><article class="article-wrap"><a class="back-link" href="/journal/">Back to the journal</a><header class="article-header"><p class="eyebrow">{frontmatter.category} · {frontmatter.readTime}</p><h1>{frontmatter.title}</h1><p class="page-lead">{frontmatter.description}</p><span class="small-note">A guide from the website journal</span></header><div class="prose"><Content /></div><div class="article-end"><p>Keep exploring, at your own pace.</p><a class="text-link" href="/journal/">More from the journal</a></div></article></main><SiteFooter />
</BaseLayout>
