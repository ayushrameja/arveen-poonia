---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroPortrait from '../components/HeroPortrait.astro';
import HeroCta from '../components/HeroCta.astro';
import WelcomeIntro from '../components/WelcomeIntro.astro';
import HeroAtmosphere from '../components/HeroAtmosphere.astro';
import HeroMantraRings from '../components/HeroMantraRings.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HomeSections from '../components/HomeSections.astro';
import ToneBackdrop from '../components/ToneBackdrop.astro';
import '../styles/closing-tone.css';
---
<BaseLayout title="Arveen Poonia — Bhakti, yoga & conscious living">
  <WelcomeIntro />
  <ToneBackdrop page />
  <SiteHeader />
  <main id="main-content" tabindex="-1">
    <section class="hero" id="home" data-scene="arveen" aria-labelledby="hero-heading">
      <HeroAtmosphere />
      <div class="portrait-stage">
      <HeroMantraRings />
      <div class="devotion-orbit" aria-hidden="true"><span></span></div>
      <HeroPortrait />
      </div>
      <div class="hero-copy">
        <div class="scene-copy-stack">
          <div class="scene-copy" data-copy-scene="arveen">
            <p class="eyebrow">Hare Krishna. I’m</p>
            <h1 id="hero-heading"><span data-hero-name>Arveen Poonia</span><span class="name-period">.</span></h1>
            <p class="intro">Sharing a journey of bhakti, yoga,<br />and conscious living.</p>
          </div>
          <div class="scene-copy" data-copy-scene="radha-krishna" aria-hidden="true">
            <p class="eyebrow">The inspiration behind my journey</p>
            <h2 class="hero-title" id="inspiration-heading">Radha–Krishna<span class="name-period">.</span></h2>
            <p class="intro">Their divine love inspires my journey<br />of devotion, presence, and service.</p>
          </div>
        </div>
        <div class="hero-actions">
          <HeroCta href="/explore/" label="Explore my videos" />
          <HeroCta href="/about/" label="My Journey" secondary />
        </div>
      </div>
    </section>
    <HomeSections />
  </main>
  <SiteFooter />
</BaseLayout>
<script>
  import { initHeroScene } from '../scripts/hero-scene';
  import { initClosingTone } from '../scripts/closing-tone';
  const hero = document.querySelector<HTMLElement>('.hero');
  if (hero) initHeroScene(hero);
  initClosingTone();
</script>
