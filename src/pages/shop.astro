---
import PageLayout from '../layouts/PageLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import products from '../data/products.json';
---
<PageLayout title="Divine Store" eyebrow="Devotion in the everyday" heading="Objects with a little more meaning." description="Discover a few devotional essentials from Arveen Divine, chosen for moments of chanting, reading, and remembrance.">
<section class="content-wrap shop-section"><h2 class="sr-only">Featured products</h2><div class="shop-note"><span>From the Arveen Divine collection</span><span>Explore here · Shop on Arveen Divine ↗</span></div><div class="product-grid">{products.map(product=><ProductCard product={product} />)}</div><p class="small-note store-disclosure">Prices, availability, shipping, and checkout are handled by Arveen Divine. Visit a product page for current details.</p></section>
<section class="section-block sage-section"><div class="content-wrap store-story"><p class="eyebrow">The intention behind the collection</p><h2>A companion<br />to your daily practice.</h2><p>Founded by Arveen Poonia, Arveen Divine brings together devotional essentials for people making space for bhakti in their lives.</p><a class="hero-cta" href="https://arveendivine.com" target="_blank" rel="noopener noreferrer">Visit Arveen Divine</a></div></section>
</PageLayout>
