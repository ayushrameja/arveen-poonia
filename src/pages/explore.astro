---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HeroCta from '../components/HeroCta.astro';
import VideoCard from '../components/VideoCard.astro';
import videos from '../data/videos.json';
import '../styles/explore.css';

const categories = ['All', 'Bhakti', 'Daily practice', 'Journeys'];
const countFor = (category: string) => category === 'All' ? videos.length : videos.filter(video => video.category === category).length;
---
<BaseLayout title="Explore — Arveen Poonia" description="Discover moments of devotion, everyday routines, and journeys with Arveen. Choose a story that speaks to you.">
  <SiteHeader breadcrumb="Explore" />
  <main id="main-content" class="explore-page" tabindex="-1">
    <section class="explore-intro content-wrap" aria-labelledby="explore-heading">
      <div>
        <p class="explore-kicker"><span aria-hidden="true">✳</span> WATCH. WONDER. REFLECT.</p>
        <h1 id="explore-heading">A little perspective<br /><span>for your day.</span></h1>
      </div>
      <div class="explore-intro-note">
        <p>Moments of devotion. Everyday rhythms. Stories from the road. Follow your curiosity, and find a story that speaks to you.</p>
        <a href="#video-library">Find your next watch <span aria-hidden="true">↓</span></a>
        <span class="explore-tally">{String(videos.length).padStart(2, '0')} STORIES <span aria-hidden="true">·</span> {String(categories.length - 1).padStart(2, '0')} THREADS TO FOLLOW</span>
      </div>
    </section>

    <section class="explore-library" id="video-library" aria-labelledby="library-heading">
      <div class="content-wrap">
        <div class="explore-library-heading"><h2 id="library-heading">Follow a little curiosity.</h2><span>Bhakti, yoga & life in between.</span></div>
        <div class="library-controls" data-library-controls hidden>
          <div class="filter-list" role="group" aria-label="Filter videos by topic">
            {categories.map(category => <button type="button" data-filter={category} aria-pressed={category === 'All'} aria-controls="video-results">{category === 'All' ? 'All stories' : category}<span aria-hidden="true">{String(countFor(category)).padStart(2, '0')}</span></button>)}
          </div>
          <label class="search-box">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /></svg>
            <span class="sr-only">Search videos</span><input type="search" id="video-search" placeholder="Find a story…" aria-controls="video-results" />
          </label>
        </div>
        <div class="explore-results-meta"><p class="result-count" data-result-count role="status" aria-live="polite">{videos.length} videos · All stories</p><span>Take your time. There’s no wrong place to begin.</span></div>
        <div class="video-grid" id="video-results">
          {videos.map((video, index) => <VideoCard video={video} featured={index === 0} poster={index === 0 ? '/videos/previews/perfect-routine.webp' : undefined} summary={index === 0 ? 'Two years of trying to get it right. A reflection on routines, expectations, and finding a rhythm that feels like you.' : undefined} />)}
        </div>
        <div class="empty-results" data-empty hidden>
          <span class="empty-orbit" aria-hidden="true">✳</span><h3>A different word, perhaps?</h3><p>No stories match this search. Try another topic, or start fresh.</p><button type="button" class="hero-cta" data-reset>Show all stories</button>
        </div>
        <p class="explore-library-note"><span aria-hidden="true">✧</span> A little curiosity. A new perspective.</p>
      </div>
    </section>

    <section class="explore-channel content-wrap explore-reveal" aria-labelledby="channel-heading">
      <div class="explore-channel-art" aria-hidden="true"><i></i><i></i><i></i><span>Stay curious.<br />Stay present.</span><b>✳</b></div>
      <div class="explore-channel-copy"><p class="explore-kicker">THERE’S MORE TO THE STORY</p><h2 id="channel-heading">The journey<br /><span>keeps unfolding.</span></h2><p>More everyday moments, more places to discover, and a little room to reflect. Keep exploring with Arveen on YouTube.</p><HeroCta href="https://www.youtube.com/@arveenpoonia31/videos" label="Explore the YouTube channel" /><span class="explore-channel-note">New stories, at your own pace.</span></div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
<script>
  import { onPageReady } from '../scripts/page-ready';
  import { initVideoLibrary } from '../scripts/video-library';
  const stop = onPageReady(initVideoLibrary);
  if (import.meta.hot) import.meta.hot.dispose(stop);
</script>
