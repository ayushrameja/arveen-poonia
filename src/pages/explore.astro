---
import PageLayout from '../layouts/PageLayout.astro';
import VideoCard from '../components/VideoCard.astro';
import videos from '../data/videos.json';
const categories=['All','Bhakti','Daily practice','Journeys'];
---
<PageLayout title="Explore" eyebrow="Watch. Wonder. Reflect." heading="A little perspective for your day." description="Discover moments of devotion, everyday routines, and journeys with Arveen. Choose a story that speaks to you.">
<section class="content-wrap library-section" aria-label="Video library">
<h2 class="sr-only">Selected videos</h2>
<div class="library-controls" data-library-controls hidden><div class="filter-list" role="group" aria-label="Filter videos by topic">{categories.map(category=><button type="button" data-filter={category} aria-pressed={category==='All'}>{category}</button>)}</div><label class="search-box"><span class="sr-only">Search videos</span><input type="search" id="video-search" placeholder="Find a video…" /></label></div>
<p class="result-count" data-result-count aria-live="polite">{videos.length} selected videos</p>
<div class="video-grid">{videos.map(video=><VideoCard video={video} />)}</div>
<div class="empty-results" data-empty hidden><h2>A different word, perhaps?</h2><p>No videos match this search. Try another topic or clear your search.</p><button type="button" class="hero-cta" data-reset>Show all videos</button></div>
<div class="channel-invite"><h2>The journey continues.</h2><p>Find more videos and the latest uploads on Arveen’s channel.</p><a class="text-link" href="https://www.youtube.com/@arveenpoonia31/videos" target="_blank" rel="noopener noreferrer">Visit YouTube ↗</a></div>
</section>
</PageLayout>
<script>
const controls=document.querySelector<HTMLElement>('[data-library-controls]');
const search=document.querySelector<HTMLInputElement>('#video-search');
const cards=Array.from(document.querySelectorAll<HTMLElement>('[data-video-card]'));
const buttons=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
let topic=new URLSearchParams(location.search).get('topic') || 'All';
if(!buttons.some(b=>b.dataset.filter===topic)) topic='All';
function update(){
 const query=search?.value.trim().toLowerCase() || '';
 let count=0;
 cards.forEach(card=>{card.hidden=!((topic==='All'||card.dataset.category===topic)&&(card.dataset.title || '').includes(query));if(!card.hidden) count++;});
 buttons.forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.filter===topic)));
 const status=document.querySelector('[data-result-count]');if(status) status.textContent=`${count} ${count===1?'video':'videos'}${topic==='All'?'':` · ${topic}`}`;
 const empty=document.querySelector<HTMLElement>('[data-empty]');if(empty) empty.hidden=count>0;
}
if(controls) controls.hidden=false;
buttons.forEach(button=>button.addEventListener('click',()=>{topic=button.dataset.filter || 'All';update();}));
search?.addEventListener('input',update);
document.querySelector('[data-reset]')?.addEventListener('click',()=>{topic='All';if(search) search.value='';update();search?.focus();});
update();
</script>
