---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/yoga.css';
import HeroCta from '../components/HeroCta.astro';
const form='https://forms.gle/6dmPZJowfUUC3jiZ7';
const faqs=[['Can I join as a beginner?','The registration form welcomes beginner, intermediate, and advanced practitioners. Share your experience and any individual needs when registering so you can discuss suitability with Arveen.'],['Where do the classes take place?','Classes are online. Follow the instructions in the registration form; the form says registered participants will be added to the class group.'],['What should I have ready?','A comfortable space to move, a yoga mat, and a device with a stable internet connection. Check any additional requirements with the instructor before your first class.'],['How do I register?','Open the registration form, choose a batch and plan, and follow its payment and confirmation instructions. Read the current terms before making a payment.'],['What if I have a health condition?','Tell the instructor about any health conditions or injuries in the registration form, and discuss whether the class is appropriate for you before joining.']];
---
<BaseLayout title="Yoga — Arveen Poonia" description="Online yoga classes that bring movement, guided meditation, and daily practice into your own space.">
  <SiteHeader breadcrumb="Yoga" />
  <main id="main-content" class="yoga-page" tabindex="-1">
    <section class="yoga-hero content-wrap" aria-labelledby="yoga-heading">
      <div class="yoga-hero-copy">
        <p class="yoga-kicker"><span aria-hidden="true">✳</span> PRACTICE WITH ARVEEN</p>
        <h1 id="yoga-heading">Make a little<br />room <span>for yourself.</span></h1>
        <p class="yoga-lead">Online yoga classes that bring movement, guided meditation, and daily practice into your own space.</p>
        <div class="yoga-actions"><HeroCta href={form} label="View registration form" /><a class="yoga-link" href="#batches"><span class="link-label">Find your batch</span><span aria-hidden="true">↓</span></a></div>
        <p class="yoga-note">Online, from home. In India or abroad.</p>
      </div>
      <div class="yoga-rhythm">
        <div class="yoga-rhythm-top"><span>A REGULAR RHYTHM</span><span aria-hidden="true">✳</span></div>
        <div class="yoga-orbit-art"><div class="yoga-orbits" aria-hidden="true"><i></i><i></i><i></i></div><p>Show up.<br />Take your time.<br /><span>Begin again.</span></p></div>
        <div class="yoga-rhythm-bottom"><span>01 / Movement</span><span>02 / Stillness</span><span>03 / Daily practice</span></div>
      </div>
      <nav class="yoga-index" aria-label="Yoga page sections">
        {[['practice','The classes'],['batches','Schedules & pricing'],['questions','Questions & answers']].map(([id,label],i)=><a href={`#${id}`}><span>0{i+1}</span>{label}<b aria-hidden="true">↘</b></a>)}
      </nav>
    </section>

    <section class="yoga-practice content-wrap" id="practice" aria-labelledby="practice-heading">
      <div><p class="yoga-kicker">A SHARED SPACE FOR PRACTICE</p><h2 id="practice-heading">Your space.<br /><span>Our daily rhythm.</span></h2><p class="yoga-copy">A shared space for yoga and guidance on building a more intentional routine. Join from home, whether you’re in India or abroad.</p></div>
      <dl class="yoga-facts">{[['Format','Online classes'],['Practice days','Monday to Friday'],['Session length','50–60 minutes'],['Your teacher','Arveen Poonia']].map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
      <a class="yoga-film" href="https://www.youtube.com/watch?v=G6urhfhD7eA" target="_blank" rel="noopener noreferrer" aria-label="Watch Arveen’s yoga journey on YouTube (opens in a new tab)">
        <div class="yoga-film-image"><img src="/videos/previews/yoga-journey.webp" alt="Arveen sharing his yoga journey" width="960" height="540" loading="lazy" decoding="async" /><span class="yoga-play" aria-hidden="true">▶</span></div>
        <div class="yoga-film-copy"><span class="yoga-kicker">BEHIND THE PRACTICE</span><h3>Every practice has a beginning.</h3><span class="yoga-link"><span class="link-label">Watch Arveen’s yoga journey</span><span aria-hidden="true">↗</span></span></div>
      </a>
    </section>

    <section class="yoga-schedule" id="batches" aria-labelledby="batches-heading"><div class="content-wrap">
      <div class="yoga-section-heading"><div><p class="yoga-kicker">A TIME THAT FITS YOUR DAY</p><h2 id="batches-heading">Begin with <span>a rhythm.</span></h2></div><p class="yoga-timezone">All times are Indian Standard Time<br /><strong>IST · UTC+5:30</strong></p></div>
      <div class="yoga-batches">
        <article class="yoga-batch yoga-batch--morning"><div class="yoga-batch-top"><h3>Morning batch</h3><svg viewBox="0 0 64 64" fill="none" aria-hidden="true"><path d="M8 46h48M14 39a18 18 0 0 1 36 0M32 9v7M8 23l6 5M56 23l-6 5M4 39h7M53 39h7" /></svg></div><p class="yoga-time">6:00 <span>AM</span></p><p>A little space before the day begins.</p><div class="yoga-batch-meta"><span>Monday–Friday</span><span>50–60 minutes</span></div></article>
        <article class="yoga-batch yoga-batch--evening"><div class="yoga-batch-top"><h3>Evening batch</h3><svg viewBox="0 0 64 64" fill="none" aria-hidden="true"><path d="M44 11a23 23 0 1 0 9 35A24 24 0 0 1 44 11Z" /><path d="M52 13v10M47 18h10" /></svg></div><p class="yoga-time">7:00 <span>PM</span></p><p>Return to your practice at the end of the day.</p><div class="yoga-batch-meta"><span>Monday–Friday</span><span>50–60 minutes</span></div></article>
      </div>
      <div class="yoga-pricing-heading"><h3>Choose your practice plan.</h3><span>Fees in Indian rupees</span></div>
      <dl class="yoga-plans">{[['1 month','₹1,500'],['3 months','₹4,000'],['6 months','₹7,000']].map(([period,price])=><div><dt>{period}</dt><dd>{price}</dd></div>)}</dl>
      <div class="yoga-booking"><p class="yoga-note">Listed in the registration form, checked 16 September 2026. Confirm current batches, fees, and terms in the form before paying.</p><HeroCta href={form} label="Choose your batch" /></div>
    </div></section>

    <section class="yoga-faq content-wrap" id="questions" aria-labelledby="questions-heading">
      <div><p class="yoga-kicker">BEFORE YOU BEGIN</p><h2 id="questions-heading">A few things<br /><span>you might wonder.</span></h2><a class="yoga-link" href="mailto:arveenpoonia0101@gmail.com"><span class="link-label">Ask about classes</span><span aria-hidden="true">↗</span></a></div>
      <div class="yoga-questions">{faqs.map(([q,a],i)=><details><summary><span class="yoga-question-number">0{i+1}</span>{q}<span class="yoga-question-toggle" aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div>
    </section>
    <section class="yoga-register content-wrap" aria-labelledby="register-heading"><div><p class="yoga-kicker">ONE DAY. ONE PRACTICE.</p><h2 id="register-heading">A little room.<br /><span>A place to begin.</span></h2></div><div><p>Choose a batch and plan in the registration form, then follow its payment and confirmation instructions.</p><HeroCta href={form} label="View registration form" /><span class="yoga-note">Read the current terms before making a payment.</span></div><span class="yoga-register-orbit" aria-hidden="true"></span></section>
  </main>
  <SiteFooter />
</BaseLayout>
