---
interface Props { product: {name:string;url:string;image:string;description:string}; }
const {product}=Astro.props;
---
<a class="product-card" href={product.url} target="_blank" rel="noopener noreferrer">
  <div class="product-image"><img src={product.image} alt={product.name} width="300" height="300" loading="lazy" decoding="async" /></div>
  <h3>{product.name}</h3><p>{product.description}</p><span class="text-link">View on Arveen Divine ↗</span>
</a>
