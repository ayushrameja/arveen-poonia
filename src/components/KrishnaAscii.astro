<figure class="divine-art">
  <div class="portrait-position">
    <div class="krishna-scene">
    <img class="ascii-portrait" src="/images/krishna-color-ascii.webp" srcset="/images/krishna-color-ascii-mobile.webp 800w, /images/krishna-color-ascii.webp 1440w" sizes="(max-width: 700px) min(115vw, calc(100svh - 220px)), min(850px, 105vw, calc(100svh - 220px))" alt="Lord Krishna in colorful ASCII, with a deep black complexion, a jeweled peacock crown, flower garlands and a golden flute." width="1440" height="1440" fetchpriority="high" decoding="async" />
    <img class="ascii-texture" src="/images/krishna-texture.webp" alt="" width="1440" height="300" decoding="async" aria-hidden="true" />
    </div>
    <div class="arveen-scene">
      <img class="profile-portrait" data-portrait-frame src="/images/arveen-profile-ascii.webp" srcset="/images/arveen-profile-ascii-mobile.webp 1200w, /images/arveen-profile-ascii.webp 1920w" sizes="(max-width: 700px) min(115vw, calc(100svh - 220px)), min(850px, 105vw, calc(100svh - 220px))" alt="Arveen Poonia smiling in his lilac kurta, based on his YouTube profile photo and rendered in colored ASCII." width="1440" height="1440" decoding="async" />
    </div>
  </div>
  <div class="art-controls" hidden>
    <button type="button" data-pause aria-label="Pause artwork animation" aria-pressed="false" title="Pause artwork animation">
      <svg data-pause-icon viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path class="pause-bars" d="M7 5v10M13 5v10"/><path class="play-triangle" d="m7 4 8 6-8 6Z"/></svg>
    </button>
  </div>
</figure>
<script>
  import { initKrishnaAscii } from '../scripts/krishna-ascii';
  const figure = document.querySelector<HTMLElement>('.divine-art');
  if (figure) initKrishnaAscii(figure);
</script>
